{
  "rewrites": [
    {
      "source": "/((?!api|brand|docs|images|videos|assets|site.webmanifest|robots.txt|sitemap.xml|browserconfig.xml).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/brand/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
